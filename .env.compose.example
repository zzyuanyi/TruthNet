# TruthNet Docker Compose 环境变量模板 — Phase D #9
# 复制为 .env.compose 并填入真实值（不提交真实密码）
# cp .env.compose.example .env.compose

# ── 服务端口（避开本地 8000/3306/7687/7474）──
BACKEND_PORT=8001
MYSQL_PORT=3307
NEO4J_BOLT_PORT=7688
NEO4J_HTTP_PORT=7475

# ── MySQL ──
MYSQL_DATABASE=truthnet
MYSQL_USER=truthnet
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── Neo4j（仅 2025.06.1）──
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── LLM Provider ──
# mock | deepseek | qwen
LLM_BACKEND=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
LLM_FALLBACK_BACKEND=

# ── 数据版本 ──
DATASET_VERSION=competition-2026
RULE_SET_VERSION=finance-rules-1.0.0
GRAPH_VERSION=equity-2026Q2
