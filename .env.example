# TruthNet 本地环境变量示例
# 复制为 .env 后按本机环境修改；不要提交 .env、密钥或真实数据库凭据。

# ===== 运行模式 =====
# lite：SQLite + NetworkX + Mock LLM，适合开发与 CI。
# full：MySQL + Neo4j + 外部模型/数据服务，需补齐相应连接信息。
TRUTHNET_PROFILE=lite
APP_NAME=TruthNet
APP_ENV=development
DEBUG=true

# ===== 本地服务 =====
# README 推荐前后端分别运行在 8001 / 5000；Docker 容器内部仍使用 8000。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# ===== 关系与图数据 =====
SQL_BACKEND=sqlite
SQLITE_PATH=data/truthnet.db

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=truthnet
MYSQL_USER=truthnet
MYSQL_PASSWORD=
MYSQL_TEST_DATABASE=
MYSQL_TEST_USER=
MYSQL_TEST_PASSWORD=
DEMO_DATABASE_NAME=truthnet
ALLOW_DEMO_DB_WRITE=false

GRAPH_BACKEND=networkx
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# ===== 模型服务 =====
# mock 不调用外部模型；deepseek / qwen 需要填写各自的 API Key。
LLM_BACKEND=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-max
LLM_FALLBACK_BACKEND=
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=5.0
LLM_REQUEST_TIMEOUT=60

# ===== 联网检索 =====
# off：关闭；mock：本地测试；anysearch / bocha：需填写相应 Key。
WEB_SEARCH_BACKEND=off
WEB_SEARCH_API_KEY=
ANYSEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
WEB_SEARCH_TIMEOUT_SECONDS=15.0
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_RATE_LIMIT_RPM=30
WEB_SEARCH_FILL_FINANCE_METRIC=true

# ===== 数据版本与本地目录 =====
DATA_ROOT=data/raw
PROCESSED_DATA_DIR=data/processed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=data/model_cache
DEFAULT_AS_OF=
DATASET_VERSION=mock-v12
RULE_SET_VERSION=finance-rules-1.0.0
GRAPH_VERSION=equity-mock-v12
REPORT_ROOT_DIR=data/reports
LOG_LEVEL=INFO
