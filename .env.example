# TruthNet 鐜鍙橀噺妯℃澘 (V12 baseline 路 2026-07-17)

# ===== Profile =====
# lite: SQLite + NetworkX + ChromaDB local + Mock LLM (榛樿寮€鍙?CI)
# full: MySQL + Neo4j + ChromaDB persistent + DeepSeek/Qwen
TRUTHNET_PROFILE=lite

# ===== 搴旂敤 =====
APP_NAME=TruthNet
APP_ENV=development
DEBUG=true

# ===== 鏈嶅姟绔彛 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 鏁版嵁搴撳悗绔?=====
# lite: sqlite | full: mysql
SQL_BACKEND=sqlite
SQLITE_PATH=data/truthnet.db

MYSQL_PORT=3306
MYSQL_DATABASE=truthnet
MYSQL_USER=truthnet
MYSQL_PASSWORD=

# ===== 鍥炬暟鎹簱鍚庣 =====
# lite: networkx | full: neo4j
GRAPH_BACKEND=networkx

NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ===== 鍚戦噺鏁版嵁搴?=====
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# ===== LLM Provider =====
# lite: mock | full: deepseek | qwen
LLM_BACKEND=mock

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

QWEN_BASE_URL=
QWEN_MODEL=qwen-max

# LLM 鍥為€€銆侀噸璇曚笌瓒呮椂
LLM_FALLBACK_BACKEND=
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=5.0
LLM_REQUEST_TIMEOUT=30

# ===== Web Search Provider（Phase E · B1 联网搜索）=====
# off（默认）= 关闭；mock = 本地测试/演示；bocha = 真实联网（需 API Key）；coze = 平台沙箱内置免 Key（仅沙箱可用，本地导入失败自动降级关闭）
WEB_SEARCH_BACKEND=off
# 选 bocha 时填 Key；选 coze 时以下三项留空即可
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
WEB_SEARCH_TIMEOUT_SECONDS=10.0
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_RATE_LIMIT_RPM=30
# AnySearch A股垂类 Key（as_sk_*，免费注册：POST /v1/auth/email/register 一次调用发 Key；不填则匿名限流低）
ANYSEARCH_API_KEY=

# ===== 宓屽叆妯″瀷 =====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 鏁版嵁娴佹按绾?=====
DATA_ROOT=data/raw
PROCESSED_DATA_DIR=data/processed
EMBEDDING_CACHE_DIR=data/model_cache

# ===== API 鐗堟湰鎺у埗 =====
API_V1_ENABLED=true
LEGACY_API_ENABLED=true

# ===== 鏁版嵁鐗堟湰 =====
DEFAULT_AS_OF=
DATASET_VERSION=mock-v12
RULE_SET_VERSION=finance-rules-1.0.0
GRAPH_VERSION=equity-mock-v12

# ===== 鏃ュ織 =====
LOG_LEVEL=INFO
