# TruthNet 鐜鍙橀噺妯℃澘 (V12 baseline 路 2026-07-17)
# 澶嶅埗姝ゆ枃浠朵负 .env 骞跺～鍏ョ湡瀹炲€?# cp .env.example .env

# ===== Profile =====
# lite: SQLite + NetworkX + ChromaDB local + Mock LLM (榛樿寮€鍙?CI)
# full: MySQL + Neo4j + ChromaDB persistent + DeepSeek/Qwen
TRUTHNET_PROFILE=lite

# ===== 搴旂敤 =====
APP_NAME=TruthNet
APP_ENV=development
DEBUG=true

# ===== 鏈嶅姟绔彛 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 鏁版嵁搴撳悗绔?=====
# lite: sqlite | full: mysql
SQL_BACKEND=sqlite
SQLITE_PATH=data/truthnet.db

# MySQL锛堜粎 full profile锛?MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=truthnet
MYSQL_USER=truthnet
MYSQL_PASSWORD=

# ===== 鍥炬暟鎹簱鍚庣 =====
# lite: networkx | full: neo4j
GRAPH_BACKEND=networkx

# Neo4j锛堜粎 full profile锛?NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ===== 鍚戦噺鏁版嵁搴?=====
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# ===== LLM Provider =====
# lite: mock | full: deepseek | qwen
LLM_BACKEND=mock

# DeepSeek锛堥」鐩粍鍏辩敤瀵嗛挜瑙佸井淇＄兢锛屽鍒跺悗濉叆涓嬫柟锛?DEEPSEEK_API_KEY=浣犵殑瀵嗛挜
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Qwen锛堥€氫箟鍗冮棶锛?QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-max

# LLM 鍥為€€銆侀噸璇曚笌瓒呮椂
LLM_FALLBACK_BACKEND=
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=5.0
LLM_REQUEST_TIMEOUT=30

# ===== Web Search Provider锛圥hase E 浼? B1 鑱旂綉鎼滅储锛?====
# off锛堥粯璁わ級= 鍏抽棴锛岃涓轰笌鐜扮姸瀹屽叏涓€鑷达紱mock = 鏈湴娴嬭瘯/婕旂ず锛?# bocha = 鐪熷疄鑱旂綉锛堟暟鎹簮鎷嶆澘鍚庡惎鐢紝鏈媿鏉夸繚鎸?off锛?WEB_SEARCH_BACKEND=off
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
WEB_SEARCH_TIMEOUT_SECONDS=10.0
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_RATE_LIMIT_RPM=30
# AnySearch A股垂类 Key（as_sk_*，免费注册：POST /v1/auth/email/register 一次调用发 Key；不填则匿名限流低）
ANYSEARCH_API_KEY=

# ===== 宓屽叆妯″瀷 =====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 鏁版嵁娴佹按绾?=====
DATA_ROOT=data/raw
PROCESSED_DATA_DIR=data/processed
EMBEDDING_CACHE_DIR=data/model_cache

# ===== API 鐗堟湰鎺у埗 =====
API_V1_ENABLED=true
LEGACY_API_ENABLED=true

# ===== 鏁版嵁鐗堟湰 =====
# full profile 璁句负 competition-2026锛沵ock/lite 淇濈暀榛樿
DEFAULT_AS_OF=
DATASET_VERSION=mock-v12
RULE_SET_VERSION=finance-rules-1.0.0
GRAPH_VERSION=equity-mock-v12

# ===== 鏃ュ織 =====
LOG_LEVEL=INFO
